# ─────────────────────────────────────────────────────────────────────────────
# Safari Travel — environment template
#
#   cp .env.example .env        (PowerShell: Copy-Item .env.example .env)
#
# .env is git-ignored. Never commit real credentials.
# Everything here is read by:
#   • scripts/safari.php  (setup, doctor, db-check, start, wp)
#   • wordpress/wp-config.php (generated; loads this file so WordPress,
#     WP-CLI and the PHP dev server all see the same values)
#   • the Vite config (via process.env, optional)
# ─────────────────────────────────────────────────────────────────────────────

# ── Database (Aiven MySQL) ───────────────────────────────────────────────────
# Aiven → your project → Services → MySQL → Overview:
#
#   DB_HOST     the "Host" column. Include the "Port" column after a colon,
#               exactly as Aiven shows it, e.g. mysql-abc123-def.g.aivencloud.com:17620
#   DB_NAME     the "Database" column (usually defaultdb)
#   DB_USER     the "User" column (usually avnadmin)
#   DB_PASSWORD Services → Connection parameters → "Reset/Show password"
#   DB_SSL      Aiven always requires TLS — keep this true.
#
# WordPress understands the host:port form natively (wpdb::parse_db_host), so
# no separate port variable is needed.
DB_HOST=your-service.aivencloud.com:12345
DB_NAME=defaultdb
DB_USER=avnadmin
DB_PASSWORD=
DB_SSL=true

# Table prefix. WordPress requires [A-Za-z0-9_] only.
DB_PREFIX=stv_

# TLS certificate verification. Keep true.
# Only set false for a throwaway local experiment — it disables authentication
# of the database server.
DB_SSL_VERIFY=true

# Optional custom CA bundle, if Aiven's certificate is not in your system trust
# store. Point this at the downloaded .crt with an absolute path.
# Download it from Aiven → Service → Connection security → CA certificate.
# DB_SSL_CA=/absolute/path/to/aiven-ca.crt

# Only used by the optional Docker MariaDB profile.
DB_ROOT_PASSWORD=rootsecret

# ── Local site ───────────────────────────────────────────────────────────────
# Port for the local PHP dev server and for docker compose.
WP_PORT=8080
# Hostname used in generated URLs. Use "localhost" locally; set the real
# hostname on production hosts.
WP_SITE_HOST=localhost
# Explicit site URL. If left blank it is derived as http://$WP_SITE_HOST:$WP_PORT.
# Set it to your production origin in production (https://www.example.com).
WP_SITE_URL=http://localhost:8080
WP_SITE_TITLE=Safari Travel

# local | development | staging | production
# "production" turns on the production safety checks in wp-config.php
# (debug refused, built-in server refused, file editing disabled).
WP_ENV=local

# Verbose error output. Leave true locally; wp-config.php refuses to boot a
# production site with WP_DEBUG on.
WP_DEBUG=true
# Never render errors into HTML in production; wp-config.php forces this off.
WP_DEBUG_DISPLAY=false

# ── First-run install ────────────────────────────────────────────────────────
# Used only when WordPress is not installed yet. An existing install is never
# re-created and never re-configured.
#
# If WP_ADMIN_PASS is left blank, setup generates a strong random password and
# appends it to this file.
WP_ADMIN_USER=admin
WP_ADMIN_PASS=
WP_ADMIN_EMAIL=admin@localhost.test

# ── Behaviour toggles ────────────────────────────────────────────────────────
# Run `wp safari seed` as part of setup.
WP_SEED_ON_SETUP=true
# Skip image side-loading when seeding (much faster; useful on slow links).
WP_SEED_NO_IMAGES=false
# Run `npm run build` as part of setup.
WP_BUILD_ON_SETUP=true
# Run the first-run install / activation steps. Set false in CI images where the
# database already contains a site.
WP_INSTALL_PLUGINS=true

# How the repository's theme/plugins/mu-plugins reach wp-content.
#   link  directory symlink, or NTFS junction on Windows (recommended, default)
#   copy  plain copy, re-synced on every setup run (escape hatch for locked-down
#         machines where links are unavailable)
WP_CONTENT_LINK_MODE=link

# Allow the WordPress admin to edit plugin/theme files. Off everywhere by default.
WP_ALLOW_FILE_EDIT=false
WP_ALLOW_FILE_MODS=false

# ── Tooling versions (pinned so every developer and CI run matches) ───────────
# WordPress core is installed by Composer from composer.json; this is only used
# by the diagnostics output to show drift between the two.
WP_CORE_VERSION=6.7.9
WP_CLI_VERSION=2.12.0

# ── Cloudflare Turnstile ─────────────────────────────────────────────────────
# Leave blank to skip Turnstile and rely on the honeypot + rate limiting.
# When set, these become the initial values for the Safari Leads settings
# (Settings → Safari Leads), so local forms work without re-typing keys.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Optional services (Docker workflow only) ─────────────────────────────────
MAILPIT_PORT=8025
