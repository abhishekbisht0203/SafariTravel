# Environment — copy to .env and fill in values
# Database — remote MySQL (e.g. Aiven). Host includes the port.
# For the bundled local MariaDB use DB_HOST=db, DB_SSL=false and
# `docker compose --profile local-db up -d`.
DB_HOST=your-mysql-host.aivencloud.com:12345
DB_NAME=defaultdb
DB_USER=avnadmin
DB_PASSWORD=
DB_SSL=true
DB_PREFIX=stv_
# Only used by the local-db profile
DB_ROOT_PASSWORD=rootsecret

WP_PORT=8080
MAILPIT_PORT=8025
WP_DEBUG=true
WP_ENV=local

# Cloudflare Turnstile (leave blank to skip Turnstile and use honeypot only)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# WP install
WP_ADMIN_USER=admin
WP_ADMIN_PASS=admin123
WP_ADMIN_EMAIL=admin@localhost.test
WP_SITE_URL=http://localhost:8080
WP_SITE_TITLE=Safari Travel
