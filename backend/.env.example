# ============================================================================
# Safari Travel — Laravel backend
#
#   cp backend/.env.example backend/.env
#   php backend/artisan key:generate
#
# The easiest path is to let the repo generate it from the root .env so the
# backend and WordPress always point at the same Aiven service:
#
#   php scripts/safari.php api-env
#
# backend/.env is git-ignored. Never commit real credentials.
# ============================================================================

APP_NAME="Safari Travel API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Bearer tokens are only meaningful over HTTPS. Set false for plain-HTTP local
# work; a production deployment should never ship with this disabled.
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:8000,127.0.0.1

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ── Database ────────────────────────────────────────────────────────────────
# Same Aiven service as WordPress. The backend separates itself with a table
# prefix instead of a second database, so no extra Aiven provisioning is needed
# and neither app can touch the other's tables.
#
#   DB_HOST  the "Host & Port" column from Aiven, e.g. svc-abc.g.aivencloud.com:17620
#   DB_NAME  usually "defaultdb"
#   DB_USER  usually "avnadmin"
DB_CONNECTION=mysql
DB_HOST=
DB_PORT=
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_TABLE_PREFIX=safari_api_
# Aiven always requires TLS. Leave the verification on outside throwaway work.
DB_SSL_VERIFY=true
# Optional custom CA bundle if Aiven's certificate is not in your trust store.
# MYSQL_ATTR_SSL_CA=/absolute/path/to/aiven-ca.crt

# For a completely local, database-free run (tests, CI, quick demos) use:
#   DB_CONNECTION=sqlite
#   DB_DATABASE=backend/database/database.sqlite
#   DB_TABLE_PREFIX=
# and then `php artisan migrate`.

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="leads@localhost.test"
MAIL_FROM_NAME="${APP_NAME}"

# ── Lead intake ─────────────────────────────────────────────────────────────
# Defaults mirror the safari-leads WordPress plugin, so both intake paths
# accept and reject exactly the same submissions.
LEAD_MIN_SUBMIT_SECONDS=3
LEAD_RATE_LIMIT_MAX=5
LEAD_RATE_LIMIT_WINDOW=600
LEAD_RETENTION_MONTHS=24
# Comma-separated inbox for new-lead notifications. Blank falls back to the
# first API operator's address.
LEAD_NOTIFY_EMAILS=
LEAD_AUTO_REPLY=false
LEAD_AUTO_REPLY_SUBJECT="Thanks for contacting Safari Travel"

# ── Cloudflare Turnstile (blank disables verification) ───────────────────────
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_TIMEOUT=10

# ── WordPress integration ───────────────────────────────────────────────────
# Where WordPress lives. Leave the credentials blank for anonymous reads of
# public endpoints; a WordPress application password is needed for anything
# authenticated.
SAFARI_WP_URL=http://localhost:8080
SAFARI_WP_USERNAME=
SAFARI_WP_APP_PASSWORD=
SAFARI_WP_TIMEOUT=8
SAFARI_WP_VERIFY_TLS=true
SAFARI_WP_CACHE_TTL=300
# Mirror API leads into the WordPress store so the wp-admin lead list agrees
# with the API. Requires SAFARI_API_KEY and the safari-api-bridge mu-plugin.
SAFARI_API_MIRROR=false

# ── WordPress -> Laravel lead delegation ────────────────────────────────────
# Shared secret required on delegated intake. When blank the requirement is
# skipped (fine for a purely local setup, never fine in production).
SAFARI_API_KEY=

# ── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated browser origins allowed to call the API. Empty means no
# cross-origin browser access at all. WordPress calls this API server-side, so
# this only matters if a browser ever talks to the API directly.
API_ALLOWED_ORIGINS=
