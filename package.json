    "eslint-plugin-compat": "^6.0.0",
    "postcss": "^8.4.35",
    "stylelint": "^16.2.0",
    "stylelint-config-standard": "^36.0.0",
    "vite": "^5.1.0"
  },
  "browserslist": [
    "last 2 Chrome versions",
    "last 2 Firefox versions",
    "last 2 Safari versions",
