{
  "name": "safari-travel-theme",
  "private": true,
  "type": "module",
  "description": "Asset build pipeline for Safari Travel WordPress theme",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
