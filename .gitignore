# Dependencies
/vendor/
/node_modules/

# Compiled assets — produced by `npm run build`. Git-ignored because CI and
# `php scripts/safari.php setup` both build them from source.
/theme/assets/dist/

# Vite dev-server flag written by the plugin in vite.config.js
/theme/.vite-dev

# Environment secrets
.env
.env.local
.env.*.local

# ── WordPress core ───────────────────────────────────────────────────────────
# Installed by Composer (roots/wordpress-no-content, pinned in composer.json).
# wp-config.php, wp-config-salts.php, wp-content and the linked theme/plugins
# all live here, so the whole directory is generated and must never be committed.
/wordpress/
/wp/

# Repository-local WP-CLI phar, downloaded by setup at a pinned version.
/wp-cli.phar

# WordPress uploads (media managed separately; shared with Docker)
/uploads/

# Local dev server pid marker
/wordpress/.safari-server.pid

# Logs & caches
*.log
.phpunit.cache/
/tests/.phpunit.result.cache

# OS
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.swp
*.swo

# Playwright
/playwright-report/
/test-results/
