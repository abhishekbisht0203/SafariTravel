<?xml version="1.0" encoding="UTF-8"?>
<!--
    WordPress-side tests.

    The Laravel backend has its own PHPUnit configuration and its own Composer
    autoloader (backend/phpunit.xml). This suite covers the WordPress
    application only: the theme, the plugins, the mu-plugins and the developer
    tooling in scripts/.

    Note the lowercase <testsuites> element: PHPUnit's schema is case
    sensitive, and <testSuites> is silently ignored, which makes the whole run
    report no tests at all.
-->
<phpunit
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/10.5/phpunit.xsd"
    bootstrap="tests/bootstrap.php"
    cacheDirectory=".phpunit.cache"
    executionOrder="depends,random"
    beStrictAboutCoverageMetadata="true"
    requireCoverageMetadata="false"
    beStrictAboutChangesToGlobalState="false"
    colors="true"
>
    <testsuites>
        <testsuite name="Safari Leads">
            <directory>tests/safari-leads</directory>
        </testsuite>
        <testsuite name="Safari Core">
            <directory>tests/safari-core</directory>
        </testsuite>
        <testsuite name="Safari Search">
            <directory>tests/safari-search</directory>
        </testsuite>
        <testsuite name="API Bridge">
            <directory>tests/api-bridge</directory>
        </testsuite>
        <testsuite name="Tooling">
            <directory>tests/tooling</directory>
        </testsuite>
    </testsuites>

    <source>
        <include>
            <directory suffix=".php">plugins/safari-core</directory>
            <directory suffix=".php">plugins/safari-leads</directory>
            <directory suffix=".php">plugins/safari-search</directory>
        </include>
        <exclude>
            <directory>plugins/safari-core/vendor</directory>
            <directory>plugins/safari-leads/vendor</directory>
        </exclude>
    </source>
</phpunit>
